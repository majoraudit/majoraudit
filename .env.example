# Copy this file to `.env`, replace the placeholder values, then run:
# docker compose up --build

# Public HTTPS port. If changed, update FRONTEND_URL to match.
APP_PORT=5173

# Django application settings
# Generate a value with:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Your Yale NetID. On startup this account is created/promoted to Django admin.
# Authentication still happens through CAS; no admin password is stored.
DJANGO_ADMIN_NETID=yournetid

# This must use HTTPS and its port must match APP_PORT.
FRONTEND_URL=https://localhost:5173
COOKIE_SECURE=True
COOKIE_SAMESITE=None
SECURE_SSL_REDIRECT=True

# Yale CAS authentication
CAS_URL=https://secure.its.yale.edu/cas/

# Yalies enriches a CAS user's profile after login. Obtain an API key from
# https://yalies.io/api. Leave the key empty if profile enrichment is not needed.
YALIES_URL=https://api.yalies.io/v2/
YALIES_API_KEY=
