SELECT 7 FROM [CLASS(AFAM 1160), CLASS(AFAM 1162), DIST_DEPT("Hu", "AFAM"), DIST_DEPT("So", "AFAM"), CLASS(AFAM 4310), CLASS(AFAM 4380), CLASS(AFAM 4391)] : "Core Classes" : 5;
SELECT 5 FROM [RANGE(AFAM 1000, AFAM 9999), RANGE(AFAM 1000, AFAM 9999), RANGE(AFAM 1000, AFAM 9999), RANGE(AFAM 1000, AFAM 9999), RANGE(AFAM 1000, AFAM 9999)] : "Area of Focus Electives" : 2;