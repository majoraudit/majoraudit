SELECT 3 FROM [
  CLASS(MATH 1200),
  SELECT 1 FROM [CLASS(PHYS 1800), CLASS(PHYS 1810), RANGE(PHYS 1800 , PHYS 1999)],
  CLASS(PHYS 2050L)
] : "Prerequisites" : 3;

SELECT 12 FROM [
  CLASS(PHYS 2060L),
  RANGE(MATH 2220 , MATH 4690),
  RANGE(MATH 2220 , MATH 4690),
  RANGE(MATH 2220 , MATH 4690),
  RANGE(MATH 2220 , MATH 4690),
  RANGE(MATH 2220 , MATH 4690),
  RANGE(MATH 2220 , MATH 4690),
  RANGE(PHYS 3000 , PHYS 4999),
  RANGE(PHYS 3000 , PHYS 4999),
  RANGE(PHYS 3000 , PHYS 4999),
  RANGE(PHYS 3000 , PHYS 4999),
  RANGE(PHYS 3000 , PHYS 4999)
] : "Core Classes" : 12;

SELECT 2 FROM [
  RANGE(MATH 2220 , MATH 4690),
  RANGE(PHYS 3000 , PHYS 4999)
] : "Electives" : 2;

SELECT 1 FROM [
  CLASS(PHYS 4710),
  CLASS(PHYS 4720)
] : "Senior Requirement" : 1;
