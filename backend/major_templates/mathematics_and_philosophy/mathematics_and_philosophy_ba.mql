SELECT 1 FROM [
  CLASS(MATH 1200),
  TAG("Equivalent Placement or Credit")
] : "Prerequisites" : 1;

SELECT 7 FROM [
  CLASS(MATH 2700),
  CLASS(PHIL 2267),
  CLASS(PHIL 4427),
  RANGE(MATH 2220 , MATH 4690),
  RANGE(MATH 2220 , MATH 4690),
  RANGE(MATH 2220 , MATH 4690),
  ATTRIBUTE(YC PHIL Logic)
] : "Core Classes" : 7;

SELECT 3 FROM [
  ATTRIBUTE(YC PHIL Logic),
  ATTRIBUTE(YC PHIL Metaphysics&Epistemol),
  ATTRIBUTE(YC PHIL Ethics & Value Theory),
  RANGE(PHIL 1000 , PHIL 4999),
  RANGE(MATH 2220 , MATH 4690)
] : "Electives" : 3;

SELECT 1 FROM [
  RANGE(MATH 4800 , MATH 4890),
  ATTRIBUTE(YC PHIL Senior Seminar)
] : "Senior Requirement" : 1;
