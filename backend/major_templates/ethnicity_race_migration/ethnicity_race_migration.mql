SELECT 2 FROM [CLASS(ERAM 2000), CLASS(ERAM 3000)] : "Required Courses" : 2;

SELECT 6 FROM [
    SELECT 1 FROM [TAG("YC ERAM Methods Course")],
    TAG("YC ERAM Area Course"),
    TAG("YC ERAM Area Course"),
    TAG("YC ERAM Area Course"),
    TAG("YC ERAM Area Course"),
    TAG("YC ERAM Area Course")
] : "Area of Interest Courses" : 3;

SELECT 2 FROM [
    TAG("YC ERAM Content Course Approved"),
    TAG("YC ERAM Content Course Approved")
] : "Additional ERAM Content Courses" : 3;

SELECT 1 FROM [
    SELECT 2 FROM [CLASS(ERAM 4091), CLASS(ERAM 4092)],
    SELECT 2 FROM [
        TAG("YC ERAM Upper Level Seminar With Senior Essay"),
        TAG("YC ERAM Upper Level Seminar")
    ]
] : "Senior Requirement" : 1;