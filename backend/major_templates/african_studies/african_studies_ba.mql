SELECT 1 FROM [DIST_DEPT("Hu", "AFST")] : "Humanities Course in African Studies" : 3;

SELECT 1 FROM [DIST_DEPT("So", "AFST")] : "Social Science Course in African Studies" : 3;

SELECT 4 FROM [PLACEMENT("African Language Course 1"), PLACEMENT("African Language Course 2"), PLACEMENT("African Language Course 3"), PLACEMENT("African Language Course 4")] : "African Language Requirement (2 years)" : 2;

SELECT 1 FROM [CLASS(AFST 5505), PLACEMENT("Research Methods Course")] : "Research Methods" : 4;

SELECT 4 FROM [RANGE(AFST 1000, AFST 9999), RANGE(AFST 1000, AFST 9999), RANGE(AFST 1000, AFST 9999), RANGE(AFST 1000, AFST 9999)] : "Area of Focus" : 1;

SELECT 1 FROM [CLASS(AFST 4491)] : "Senior Essay" : 5;