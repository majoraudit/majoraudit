SELECT 1 FROM [
  DIST_DEPT("L3", "SPAN"),
  DIST_DEPT("L3", "PORT"),
  PLACEMENT("Equivalent Placement or Credit")
] : "Prerequisites" : 1;

SELECT 8 FROM [
  PLACEMENT("LAST Approved Course"),
  TAG("YC PLSC Comparative Govt"),
  TAG("YC ANTH Sociocultural"),
  TAG("YC ECON Development"),
  TAG("YC HIST Latin America"),
  TAG("YC SPAN Taught in Spanish"),
  TAG("YC HSAR The Americas"),
  TAG("YC FILM World Cinema")
] : "Core Classes" : 8;

SELECT 3 FROM [
  TAG("YC HUMS Area Literature"),
  TAG("YC HUMS Area History"),
  TAG("YC HUMS Area Arts"),
  TAG("YC SOCY InequalityRaceSociety"),
  TAG("YC ECON International"),
  TAG("YC EVST Core Human/Social Sci")
] : "Electives" : 3;

SELECT 1 FROM [
  CLASS(LAST 4491),
  CLASS(LAST 4492)
] : "Senior Requirement" : 1;
