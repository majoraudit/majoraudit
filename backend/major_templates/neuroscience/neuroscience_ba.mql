SELECT 2 FROM [CLASS(NSCI 1600), CLASS(NSCI 3200)] : "Core Classes" : 1
SELECT 1 FROM [CLASS(NSCI 2280L), CLASS(NSCI 2290L), CLASS(NSCI 2400), CLASS(NSCI 2580), CLASS(NSCI 2600), CLASS(NSCI 2700), CLASS(NSCI 3210L), CLASS(PSYC 2538)] : "Labs" : 2
SELECT 11 FROM [RANGE(NSCI 2000 , NSCI 4999), RANGE(PSYC 2000 , PSYC 4999)] : "Electives" : 3
SELECT 2 FROM [CLASS(NSCI 4800), CLASS(NSCI 4810), CLASS(NSCI 4900), CLASS(NSCI 4910)] : "Senior Requirement" : 4