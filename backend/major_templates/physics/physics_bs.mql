SELECT 1 FROM [CLASS(PHYS 4000), RANGE(MATH 2000 , MATH 4999), RANGE(ENAS 1500 , ENAS 4999)] : "Advanced Math" : 1
SELECT 3 FROM [CLASS(PHYS 4010), CLASS(PHYS 4020), SELECT 1 FROM [CLASS(PHYS 4390), CLASS(PHYS 4400)]] : "Core Physics" : 2
SELECT 1 FROM [CLASS(PHYS 2060L)] : "Laboratory" : 3
SELECT 3 FROM [RANGE(PHYS 3000 , PHYS 4999)] : "Advanced Electives" : 4
SELECT 1 FROM [CLASS(PHYS 4710), CLASS(PHYS 4720)] : "Senior Requirement" : 5