SELECT 1 FROM [CLASS(PHYS 4000), RANGE(MATH 2000 , MATH 4999), RANGE(ENAS 1500 , ENAS 4999)] : "Advanced Math" : 1
SELECT 5 FROM [CLASS(PHYS 4100), CLASS(PHYS 4300), CLASS(PHYS 4410), CLASS(PHYS 4500), SELECT 1 FROM [CLASS(PHYS 4390), CLASS(PHYS 4400)]] : "Core Physics (Intensive)" : 2
SELECT 2 FROM [CLASS(PHYS 2060L), CLASS(PHYS 4450L)] : "Labs" : 3
SELECT 1 FROM [RANGE(PHYS 3000 , PHYS 4999)] : "Advanced Elective (Intensive)" : 4
SELECT 2 FROM [CLASS(PHYS 4710), CLASS(PHYS 4720)] : "Senior Requirement (Intensive)" : 5