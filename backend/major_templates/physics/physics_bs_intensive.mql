SELECT 1 FROM [
    SELECT 2 FROM [CLASS(PHYS 1700), CLASS(PHYS 1710)],
    SELECT 2 FROM [CLASS(PHYS 1800), CLASS(PHYS 1810)],
    SELECT 2 FROM [CLASS(PHYS 2000), CLASS(PHYS 2010)],
    SELECT 2 FROM [CLASS(PHYS 2600), CLASS(PHYS 2610)]
] : "Introductory Physics" : 1;

SELECT 1 FROM [
    SELECT 2 FROM [CLASS(PHYS 1650L), CLASS(PHYS 1660L)],
    SELECT 2 FROM [CLASS(PHYS 2050L), CLASS(PHYS 2060L)]
] : "Introductory Lab" : 2;

SELECT 1 FROM [CLASS(PHYS 4000), RANGE(MATH 2000 , MATH 4999), RANGE(ENAS 1500 , ENAS 4999)] : "Advanced Math" : 3;
SELECT 5 FROM [CLASS(PHYS 4100), CLASS(PHYS 4300), SELECT 1 FROM [CLASS(PHYS 4390), CLASS(PHYS 4400)], CLASS(PHYS 4410), CLASS(PHYS 4500)] : "Core Physics (Intensive)" : 4;
SELECT 2 FROM [CLASS(PHYS 2060L), CLASS(PHYS 4450L)] : "Labs" : 5;
SELECT 1 FROM [RANGE(PHYS 3000 , PHYS 4999), RANGE(PHYS 3000 , PHYS 4999), RANGE(PHYS 3000 , PHYS 4999), RANGE(PHYS 3000 , PHYS 4999)] : "Advanced Elective (Intensive)" : 6;
SELECT 2 FROM [CLASS(PHYS 4710), CLASS(PHYS 4720)] : "Senior Requirement (Intensive)" : 7;