SELECT 4 FROM [RANGE(ARBC 1000 , ARBC 4999), RANGE(HEBR 1000 , HEBR 4999), RANGE(PERS 1000 , PERS 4999), RANGE(TKSH 1000 , TKSH 4999), RANGE(NELC 1000 , NELC 4999)] : "Languages" : 1;
SELECT 7 FROM [RANGE(NELC 1000 , NELC 4999)] : "NELC Courses" : 2;
SELECT 1 FROM [CLASS(NELC 4920), CLASS(NELC 4930)] : "Senior Requirement" : 3;