SELECT 1 FROM [
    CLASS(ASTR 4920)
] : "Senior Requirement (Senior Essay / Research Project)" : 1;

SELECT 3 FROM [
    SELECT 1 FROM [CLASS(ASTR 2100), CLASS(ASTR 2200)],
    CLASS(ASTR 2550),
    CLASS(ASTR 3100)
] : "Core Astronomy Courses (ASTR 2100/2200, 2550, 3100)" : 2;

SELECT 1 FROM [
    RANGE(ASTR 1500 , ASTR 9999)
] : "Astronomy Elective (ASTR 1500+)" : 3;

SELECT 2 FROM [
    CLASS(MATH 1200),
    CLASS(ENAS 1510),
    CLASS(CPSC 1001),
    CLASS(ASTR 3560),
    RANGE(MATH 2000 , MATH 9999),
    RANGE(S&DS 2000 , S&DS 9999),
    RANGE(CPSC 2000 , CPSC 9999)
] : "Advanced Mathematics / Methods Courses" : 4;

SELECT 3 FROM [
    RANGE(ASTR 1500 , ASTR 9999),
    RANGE(PHYS 1500 , PHYS 9999),
    RANGE(MATH 1500 , MATH 9999),
    RANGE(S&DS 1500 , S&DS 9999),
    RANGE(CPSC 1500 , CPSC 9999),
    RANGE(CHEM 1500 , CHEM 9999),
    RANGE(EPS 1500 , EPS 9999),
    RANGE(BENG 1500 , BENG 9999),
    RANGE(MENG 1500 , MENG 9999),
    RANGE(ENAS 1500 , ENAS 9999)
] : "Science Electives (Natural/Applied/Mathematical Sciences; ≥2 with prerequisites)" : 5;
