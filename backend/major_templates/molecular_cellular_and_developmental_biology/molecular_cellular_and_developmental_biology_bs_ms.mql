SELECT 3 FROM [CLASS(MCDB 2000), CLASS(MCDB 2020), CLASS(MCDB 2050), CLASS(MCDB 2100), CLASS(MCDB 2900), CLASS(MCDB 3000), CLASS(MB&B 3000)] : "Core Classes" : 1
SELECT 4 FROM [RANGE(MCDB 5000, MCDB 9999), TAG("YC MCDB Graduate Seminar")] : "Graduate-Level Electives" : 2
SELECT 2 FROM [RANGE(MCDB 3000, MCDB 3999)] : "Labs" : 3
SELECT 1 FROM [CLASS(MCDB 5850)] : "Junior Year Research Course" : 4
SELECT 2 FROM [CLASS(MCDB 5950), CLASS(MCDB 5960)] : "Senior Year Research Courses" : 5

