SELECT 3 FROM [CLASS(MCDB 2000), CLASS(MCDB 2020), CLASS(MCDB 2050), CLASS(MCDB 2100), CLASS(MCDB 2900), CLASS(MCDB 3000), CLASS(MB&B 3000)] : "Core Classes" : 1
SELECT 2 FROM [RANGE(MCDB 2500, MCDB 4999), CLASS(MCDB 2000), CLASS(MCDB 2020), CLASS(MCDB 2050), CLASS(MCDB 2100), CLASS(MCDB 2900), CLASS(MCDB 3000), CLASS(MB&B 3000), TAG("Second Term Organic Chemistry"), TAG("Statistics Course for MCDB")] : "Electives" : 2
SELECT 1 FROM [RANGE(MCDB 3500, MCDB 4999)] : "Special Electives" : 3
SELECT 2 FROM [RANGE(MCDB 3000, MCDB 3999)] : "Labs" : 4
SELECT 2 FROM [CLASS(MCDB 4850), CLASS(MCDB 4860)] : "Senior Requirement" : 5