SELECT 1 FROM [CLASS(CPSC 1001)] : "Prerequisite" : 1;
SELECT 6 FROM [
    CLASS(CPSC 2010), 
    SELECT 1 FROM [
        CLASS(CPSC 2020),
        CLASS(MATH 2440)
    ], 
    CLASS(CPSC 2230), 
    SELECT 1 FROM [
        CLASS(CPSC 4780),
        CLASS(CPSC 4790)
    ],
    SELECT 1 FROM [
        CLASS(CPSC 3760),
        CLASS(CPSC 4370),
        CLASS(CPSC 4510),
        CLASS(CPSC 4750),
        CLASS(CPSC 4780),
        CLASS(CPSC 4790)
    ],
    TAG("YC CPAR HSAR CS Elective")
] : "Computer Science Courses" : 2;

SELECT 6 FROM [
    RANGE(HSAR 1000, HSAR 1999), 
    RANGE(HSAR 2000, HSAR 4999), 
    RANGE(HSAR 2000, HSAR 4999), 
    PLACEMENT("Studio Art Course"), 
    CLASS(HSAR 4401), 
    PLACEMENT("4000-level HSAR Seminar")
] : "History of Art Courses" : 2;

SELECT 2 FROM [
    CLASS(CPSC 4900), 
    CLASS(HSAR 4499)
] : "Senior Requirements" : 1;