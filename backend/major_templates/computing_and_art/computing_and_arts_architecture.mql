SELECT 1 FROM [CLASS(CPSC 1001)] : "Prerequisite" : 1;

SELECT 6 FROM [
    CLASS(CPSC 2010),
    SELECT 1 FROM [
        CLASS(CPSC 2020),
        CLASS(MATH 2440)
    ],
    CLASS(CPSC 2230),
    SELECT 1 FROM [
        CLASS(CPSC 3760),
        CLASS(CPSC 4370),
        CLASS(CPSC 4460),
        CLASS(CPSC 4510),
        CLASS(CPSC 4750),
        CLASS(CPSC 4780),
        CLASS(CPSC 4790),
        CLASS(CPSC 4840)
    ],
    TAG("YC CPAR ARCH CS Elective")
] : "Computer Science Courses" : 2;

SELECT 6 FROM [CLASS(ARCH 1001), CLASS(ARCH 2000), SELECT 2 FROM [CLASS(ARCH 2001), CLASS(ARCH 2003), CLASS(ARCH 3304), CLASS(ARCH 3305)], PLACEMENT("Architecture Elective with DUS Approval"), PLACEMENT("Architecture Elective with DUS Approval")] : "Architecture Courses" : 2;

SELECT 2 FROM [CLASS(CPSC 4900), RANGE(MUSI 4996, MUSI 4999)] : "Senior Requirements" : 1;