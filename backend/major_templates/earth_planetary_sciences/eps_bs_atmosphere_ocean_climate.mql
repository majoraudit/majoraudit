SELECT 8 FROM [SELECT 1 FROM [CLASS(MATH 1200), CLASS(ENAS 1510)], SELECT 1 FROM [CLASS(CHEM 1650), CLASS(CHEM 1670)], CLASS(PHYS 1800), CLASS(PHYS 1810), CLASS(PHYS 2050L), CLASS(PHYS 2060L), SELECT 1 FROM [CLASS(ENAS 1300), PLACEMENT("Equivalent Qualification")], CLASS(ENAS 1940)] : "Prerequisites" : 1;
SELECT 6 FROM [SELECT 1 FROM [CLASS(EPS 1000), CLASS(EPS 1010), SELECT 2 FROM [CLASS(EPS 1100), CLASS(EPS 1110L)], SELECT 2 FROM [CLASS(EPS 1250), CLASS(EPS 1260L)]], CLASS(EPS 1400), CLASS(EPS 3220), CLASS(EPS 3350), CLASS(MENG 3422), SELECT 1 FROM [CLASS(S&DS 2300), CLASS(S&DS 2380), CLASS(MATH 2220)]] : "EPS Core Courses" : 2;
SELECT 4 FROM [PLACEMENT("Class with DUS Approval"), PLACEMENT("Class with DUS Approval"), PLACEMENT("Class with DUS Approval"), PLACEMENT("EPS Class with DUS Approval")] : "Electives" : 3;
SELECT 1 FROM [CLASS(EPS 4920), SELECT 2 FROM [CLASS(EPS 4900), CLASS(EPS 4910)]] : "Senior Requirement" : 1;