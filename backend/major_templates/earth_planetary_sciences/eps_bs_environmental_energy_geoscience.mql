SELECT 3 FROM [SELECT 1 FROM [CLASS(MATH 1200), CLASS(ENAS 1510)], SELECT 1 FROM [CLASS(CHEM 1650), CLASS(CHEM 1670)], SELECT 1 FROM [SELECT 2 FROM [CLASS(PHYS 1700), CLASS(PHYS 1710)], SELECT 2 FROM [CLASS(PHYS 1800), CLASS(PHYS 1810)], SELECT 2 FROM [CLASS(PHYS 2000), CLASS(PHYS 2010)], SELECT 2 FROM[SELECT 1 FROM [SELECT 2 FROM [CLASS(BIOL 1010), CLASS(BIOL 1020)], CLASS(MCDB 1200)], SELECT 1 FROM [SELECT 2 FROM [CLASS(BIOL 1030), CLASS(BIOL 1040)], SELECT 2 FROM [CLASS(EPS 1250), CLASS(EPS 1260L)]]]]] : "Prerequisites" : 1;
SELECT 2 FROM [CLASS(EPS 1000), CLASS(EPS 1010), SELECT 2 FROM [CLASS(EPS 1100), CLASS(1110L)], SELECT 2 FROM [CLASS(EPS 1250), CLASS(EPS 1260L)], CLASS(EPS 1400)] : "Intro EPS Courses" : 2;
SELECT 4 FROM [CLASS(EPS 2320), CLASS(EPS 2550), CLASS(EPS 2740), CLASS(EPS 2750), CLASS(EPS 3100), CLASS(EPS 2100), SELECT 3 FROM[CLASS(EPS 2200), CLASS(EPS 3120), CLASS(EPS 3220)], CLASS(EPS 3620)] : "EPS Core Courses" : 2;
SELECT 4 FROM [PLACEMENT("Class with DUS Approval"), PLACEMENT("Class with DUS Approval"), PLACEMENT("EPS Class with DUS Approval"), PLACEMENT("EPS Class with DUS Approval")] : "Electives" : 3;
SELECT 1 FROM [CLASS(EPS 4920), SELECT 2 FROM [CLASS(EPS 4900), CLASS(EPS 4910)]] : "Senior Requirement" : 1;