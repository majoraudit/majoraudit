    SELECT 1 FROM DIST("L5"),
    SELECT 1 FROM DIST("L4"),
    SELECT 1 FROM DIST("L3"),
    SELECT 1 FROM DIST("L2"),
    SELECT 1 FROM DIST("L1")
] : "Language requirement (minimum)";