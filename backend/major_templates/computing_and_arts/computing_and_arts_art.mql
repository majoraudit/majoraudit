SELECT 3 FROM [
    CLASS(ART 1111),
    CLASS(ART 1514),
    PLACEMENT("Sophomore Review at the School of Art")
] : "Prerequisites" : 4;

SELECT 6 FROM [
    CLASS(CPSC 2010),
    SELECT 1 FROM [
        CLASS(CPSC 2020),
        CLASS(MATH 2440)
    ],
    CLASS(CPSC 2230),
    SELECT 2 FROM [
        CLASS(CPSC 3760),
        CLASS(CPSC 4370),
        CLASS(CPSC 4460),
        CLASS(CPSC 4510),
        CLASS(CPSC 4750),
        CLASS(CPSC 4780),
        CLASS(CPSC 4790),
        CLASS(CPSC 4840)
    ],
    RANGE(CPSC 2000, CPSC 9999)
] : "Computer Science Courses" : 1;

SELECT 6 FROM [
    SELECT 2 FROM [
        RANGE(ART 1000, ART 1999),
        RANGE(ART 1000, ART 1999)
    ],
    SELECT 2 FROM [
        RANGE(ART 2000, ART 3999),
        RANGE(ART 2000, ART 3999)
    ],
    CLASS(ART 3995),
    CLASS(ART 4995)
] : "Art Courses" : 2;

SELECT 2 FROM [CLASS(CPSC 4900), CLASS(ART 4996)] : "Senior Requirements" : 3;
