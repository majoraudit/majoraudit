SELECT 6 FROM [
    CLASS(CPSC 2010),
    SELECT 1 FROM [
        CLASS(CPSC 2020),
        CLASS(MATH 2440)
    ],
    CLASS(CPSC 2230),
    CLASS(CPSC 4310),
    CLASS(CPSC 4320),
    RANGE(CPSC 2000, CPSC 9999)
] : "Computer Science Courses" : 1;

SELECT 6 FROM [
    SELECT 2 FROM [
        RANGE(MUSI 2100, MUSI 2199),
        RANGE(MUSI 2100, MUSI 2199),
        RANGE(MUSI 3100, MUSI 3199),
        RANGE(MUSI 3100, MUSI 3199),
        RANGE(MUSI 4100, MUSI 4199),
        RANGE(MUSI 4100, MUSI 4199)
    ],
    SELECT 3 FROM [
        RANGE(MUSI 2100, MUSI 2299),
        RANGE(MUSI 2100, MUSI 2299),
        RANGE(MUSI 2100, MUSI 2299),
        RANGE(MUSI 3100, MUSI 3299),
        RANGE(MUSI 3100, MUSI 3299),
        RANGE(MUSI 3100, MUSI 3299),
        RANGE(MUSI 4100, MUSI 4299),
        RANGE(MUSI 4100, MUSI 4299),
        RANGE(MUSI 4100, MUSI 4299)
    ],
    SELECT 1 FROM [
        RANGE(MUSI 2300, MUSI 2499),
        RANGE(MUSI 3300, MUSI 3499),
        RANGE(MUSI 4300, MUSI 4499)
    ]
] : "Music Courses" : 2;

SELECT 2 FROM [
    CLASS(CPSC 4900),
    RANGE(MUSI 4996, MUSI 4999)
] : "Senior Requirements" : 3;
