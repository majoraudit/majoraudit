SELECT 8 FROM [
    SELECT 1 FROM [CLASS(PHIL 1175), CLASS(PHIL 0175)],
    SELECT 1 FROM [CLASS(PHIL 1178), CLASS(PHIL 0178), CLASS(PLSC 0108), CLASS(PLSC 1327), CLASS(PLSC 0114), CLASS(PLSC 1335), CLASS(PLSC 0118), CLASS(PLSC 1352), CLASS(PLSC 0119)],
    SELECT 1 FROM [CLASS(PLSC 1113), CLASS(PLSC 0111), CLASS(PLSC 1222), CLASS(PLSC 0113), CLASS(PLSC 1413), CLASS(PLSC 0116)],
    SELECT 1 FROM [RANGE(HIST 0000 , HIST 9999), RANGE(SOCY 0000 , SOCY 9999), RANGE(ANTH 0000 , ANTH 9999), TAG("YC ER&M Elec Within the Major"), RANGE(WGSS 0000 , WGSS 9999), PLACEMENT("Other Perspectives course approved by EP&E DUS")],
    SELECT 1 FROM [CLASS(ECON 1108), CLASS(ECON 0108), CLASS(ECON 1110), CLASS(ECON 0110), CLASS(ECON 1115), CLASS(ECON 0115)],
    SELECT 1 FROM [CLASS(ECON 1111), CLASS(ECON 0111), CLASS(ECON 1116), CLASS(ECON 0116)],
    SELECT 1 FROM [CLASS(ECON 1117), CLASS(ECON 0117), CLASS(ECON 2123), CLASS(ECON 0123), CLASS(ECON 2135), CLASS(ECON 0135), CLASS(SDSS 2300), CLASS(SDSS 0230), CLASS(SDSS 2380), CLASS(SDSS 0238)],
    SELECT 1 FROM [CLASS(EPEE 4220), CLASS(EPEE 0220), CLASS(EPEE 4231), CLASS(EPEE 0231), CLASS(EPEE 4295), CLASS(EPEE 0295), CLASS(EPEE 4297), CLASS(EPEE 0297), CLASS(ECON 2159), CLASS(ECON 0159)]
] : "Introductory Courses (8 categories)";

SELECT 1 FROM [
    CLASS(ECON 2121),
    CLASS(ECON 2125)
] : "Intermediate Microeconomics";

SELECT 3 FROM [
    SELECT 1 FROM [
        CLASS(EPEE 3212),
        CLASS(EPEE 3213),
        CLASS(EPEE 3214),
        CLASS(EPEE 3215),
        CLASS(EPEE 3216),
        CLASS(EPEE 3217)
    ],
    SELECT 2 FROM [
        SELECT 1 FROM [TAG("YC EP&E Advanced Seminar")],
        SELECT 1 FROM [
            TAG("YC EP&E Ethics Core"),
            TAG("YC EP&E Politics Core"),
            TAG("YC EP&E Economics Core")
        ]
    ]
] : "Core Courses (Classics plus 2 core area courses, one advanced)";

SELECT 3 FROM [
    PLACEMENT("Concentration course 1 (seminar or lecture, DUS approved)"),
    PLACEMENT("Concentration course 2 (seminar or lecture, DUS approved)"),
    SELECT 1 FROM [
        CLASS(EPEE 4491),
        SELECT 2 FROM [CLASS(EPEE 4492), CLASS(EPEE 4493)],
        PLACEMENT("Seminar with senior essay")
    ]
] : "Concentration (2 courses plus senior essay)";