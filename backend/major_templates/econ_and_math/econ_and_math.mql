SELECT 3 FROM [SELECT 2 FROM [CLASS(MATH 1200), PLACEMENT("Upper-Level Math Course with MATH DUS Approval")], SELECT 1 FROM [CLASS(ECON 1110), CLASS(ECON 1115), PLACEMENT("Upper-Level Economics Course")], SELECT 1 FROM [CLASS(ECON 1111), CLASS(ECON 1116), PLACEMENT("Upper-Level Economics Course")]] : "Prerequisites" : 1;
SELECT 7 FROM [SELECT 1 FROM [CLASS(ECON 2121), CLASS(ECON 2125)], SELECT 1 FROM [CLASS(ECON 2122), CLASS(ECON 2126)], SELECT 1 FROM [CLASS(ECON 3351), CLASS(ECON 4425)], SELECT 1 FROM [CLASS(ECON 3350), CLASS(ECON 4417), CLASS(ECON 4433)], SELECT 1 FROM [CLASS(ECON 2135), SELECT 2 FROM [CLASS(S&DS 2410), CLASS(S&DS 2420)]], CLASS(ECON 2136), RANGE(ECON 2120, ECON 9999)] : "ECON Core Courses" : 2;
SELECT 2 FROM [SELECT 1 FROM [CLASS(MATH 2250), CLASS(MATH 2260)], SELECT 1 FROM [CLASS(MATH 2550), CLASS(MATH 2560)]] : "MATH Core Courses" : 2;
SELECT 2 FROM [SELECT 1 FROM [RANGE(MATH 2250, MATH 2409), RANGE(MATH 2411, MATH 2419), RANGE(MATH 2421, MATH 4699), RANGE(MATH 4701, MATH 4999)], SELECT 1 FROM [RANGE(MATH 2250, MATH 2409), RANGE(MATH 2411, MATH 2419), RANGE(MATH 2421, MATH 4699), RANGE(MATH 4701, MATH 4999)]] : "MATH Electives" : 3;
SELECT 1 FROM [CLASS(MATH 4800), CLASS(MATH 4810), TAG("YC ECON Theory Seminar")] : "Senior Requirement" : 1;