SELECT 2 FROM [
  DIST("HU"),
  DIST("SO")
] : "Core HU or SO Courses" : 2;

SELECT 2 FROM [
  DIST("SC")
] : "Core Science Courses" : 3;

SELECT 3 FROM [
  DIST("SC")
] : "Science Distribution Concentration Courses" : 4;

SELECT 3 FROM [
  DEPT("EVST"),
  TAG("YC EVST Core Human/Social Sci"),
  TAG("YC EVST Core BS Natural Scie")
] : "Other Concentration Courses" : 5;

SELECT 2 FROM [
  CLASS(EVST 4960)
] : "Two Term Senior Research Project" : 1;
