-- =========================
-- PREREQUISITES
-- =========================
SELECT 2 FROM [CLASS(ART 1111), CLASS(ART 1514)] : "Prereq: Mandatory Intro Courses (ART 1111, 1514)" : 1;
SELECT 3 FROM [RANGE(ART 0001, ART 1999)] : "Prereq: Three Additional Intro Courses (1000-level)" : 2;

-- =========================
-- GENERAL REQUIREMENTS
-- =========================
SELECT 4 FROM [RANGE(ART 2000, ART 9999)] : "2000+ Level Studio Courses (non-concentration)" : 3;
SELECT 1 FROM [CLASS(ART 3995)] : "Junior Seminar" : 4;

SELECT 2 FROM [RANGE(HIST 0000, HIST 9999)] : "History of Art (or DUS-approved equivalents)" : 5;

-- =========================
-- AREAS OF CONCENTRATION
-- Students select ONE concentration
-- =========================

SELECT 1 FROM [

    -- GRAPHIC DESIGN
    SELECT 6 FROM [
        CLASS(ART 1732),
        CLASS(ART 2764),
        CLASS(ART 2765),
        SELECT 1 FROM [CLASS(ART 2766), CLASS(ART 3768)],
        SELECT 1 FROM [CLASS(ART 3769), CLASS(ART 3770)],
        SELECT 1 FROM [CLASS(ART 4768), CLASS(ART 4769)]
    ] : "Graphic Design Concentration" : 6,

    -- PAINTING / PRINTMAKING
    SELECT 6 FROM [
        CLASS(ART 1516),
        CLASS(ART 1530),
        SELECT 1 FROM [CLASS(ART 3531), CLASS(ART 3532)],
        SELECT 1 FROM [CLASS(ART 2524), CLASS(ART 2545), CLASS(ART 3556)],
        SELECT 1 FROM [CLASS(ART 4514), CLASS(ART 4532), CLASS(ART 4533), CLASS(ART 4557)],
        RANGE(ART 2000, ART 9999)   -- any additional required upper-level course
    ] : "Painting/Printmaking Concentration" : 7,

    -- PHOTOGRAPHY
    SELECT 6 FROM [
        SELECT 1 FROM [CLASS(ART 1836), CLASS(ART 1838)],
        SELECT 1 FROM [CLASS(ART 2837), CLASS(ART 2839)],
        SELECT 1 FROM [CLASS(ART 3837), CLASS(ART 3838)],
        CLASS(ART 3879),
        CLASS(ART 4801),
        RANGE(ART 2000, ART 9999)
    ] : "Photography Concentration" : 8,

    -- SCULPTURE
    SELECT 5 FROM [
        SELECT 2 FROM [
            CLASS(ART 1610), CLASS(ART 1620),
            CLASS(ART 1621), CLASS(ART 1622), CLASS(ART 1623)
        ],
        SELECT 3 FROM [
            CLASS(ART 2610),
            CLASS(ART 3646),
            CLASS(ART 3648),
            CLASS(ART 3771),
            CLASS(ART 4646)
        ]
    ] : "Sculpture Concentration" : 9,

    -- FILMMAKING
    SELECT 4 FROM [
        CLASS(ART 1942),
        CLASS(ART 3941),
        CLASS(ART 3942),
        SELECT 1 FROM [CLASS(ART 4942), CLASS(ART 4943)]
    ] : "Filmmaking Concentration" : 10

] : "Area of Concentration (choose one)" : 6;

-- =========================
-- SENIOR REQUIREMENT
-- =========================
SELECT 2 FROM [CLASS(ART 4995), CLASS(ART 4996)] : "Senior Project (Two-Term)" : 11;
