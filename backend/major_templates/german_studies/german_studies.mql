SELECT 2 FROM [
    PLACEMENT("First year German completed or equivalent"),
    PLACEMENT("Second year German completed or equivalent")
] : "Prerequisites" : 1;

SELECT 1 FROM [
    SELECT 10 FROM [
        SELECT 1 FROM [RANGE(GMAN 1500 , GMAN 1599)],
        SELECT 6 FROM [
            RANGE(GMAN 1600 , GMAN 1699),
            RANGE(GMAN 1700 , GMAN 1799),
            TAG("YC GMAN Group B or C 1600 Plus"),
            TAG("YC GMAN Group B or C 1600 Plus"),
            TAG("YC GMAN Group B or C 1600 Plus"),
            TAG("YC GMAN Group B or C 1600 Plus")
        ],
        SELECT 2 FROM [RANGE(GMAN 1600 , GMAN 9999), RANGE(GMAN 1600 , GMAN 9999)],
        SELECT 1 FROM [CLASS(GMAN 4920)]
    ],
    SELECT 10 FROM [
        SELECT 1 FROM [RANGE(GMAN 1500 , GMAN 1599)],
        SELECT 6 FROM [
            RANGE(GMAN 1600 , GMAN 1699),
            RANGE(GMAN 1700 , GMAN 1799),
            TAG("YC GMAN Group B or C 1600 Plus"),
            TAG("YC GMAN Group B or C 1600 Plus"),
            TAG("YC GMAN Group B or C 1600 Plus"),
            TAG("YC GMAN Group B or C 1600 Plus")
        ],
        SELECT 1 FROM [RANGE(GMAN 1600 , GMAN 9999)],
        SELECT 2 FROM [CLASS(GMAN 4920), CLASS(GMAN 4930)]
    ]
] : "German Studies Major Plan" : 1;
