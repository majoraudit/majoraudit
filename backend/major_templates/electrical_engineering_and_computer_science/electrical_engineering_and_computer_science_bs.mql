SELECT 4 FROM [SELECT 1 FROM [SELECT 2 FROM [CLASS(MATH 1120), SELECT 1 FROM [SELECT 2 FROM [CLASS(PHYS 1700), CLASS(PHYS 1710)], SELECT 2 FROM [CLASS(PHYS 1800), CLASS(PHYS 1810)], SELECT 2 FROM [CLASS(PHYS 2000), CLASS(PHYS 2010)]]], SELECT 2 FROM [PLACEMENT("Equivalent Qualification"), SELECT 1 FROM [SELECT 2 FROM [CLASS(PHYS 1800), CLASS(PHYS 1810)], SELECT 2 FROM [CLASS(PHYS 2000), CLASS(PHYS 2010)]]]], SELECT 1 FROM [CLASS(MATH 1150), PLACEMENT("Equivalent Qualification")], SELECT 1 FROM [CLASS(ENAS 1510), CLASS(MATH 1200)], SELECT 1 FROM [CLASS(CPSC 1001), PLACEMENT("Equivalent Qualification")]] : "Prerequisites" : 1;
SELECT 5 FROM [CLASS(CPSC 2010), SELECT 1 FROM [CLASS(CPSC 2020), CLASS(MATH 2440)], CLASS(CPSC 2230), CLASS(CPSC 3230), SELECT 1 FROM [CLASS(CPSC 3650), CLASS(3660)]] : "CS Core Courses" : 2;
SELECT 4 FROM [CLASS(ECE 2000), CLASS(ECE 2011), CLASS(ECE 2020), CLASS(ECE 2031)] : "EE Core Courses" : 2;
SELECT 1 FROM [CLASS(MATH 2220), CLASS(MATH 2250), CLASS(MATH 2260), CLASS(S&DS 2380), CLASS(S&DS 2410)] : "Math Core Course" : 2;
SELECT 4 FROM [SELECT 1 FROM [RANGE(CPSC 3000, CPSC 3649), RANGE(CPSC 3651, CPSC 3659), RANGE(CPSC 3661, CPSC 4899), RANGE(CPSC 4901, CPSC 4999), PLACEMENT("EECS Elective with Approval from Both DUSs")], SELECT 1 FROM [RANGE(CPSC 3000, CPSC 3649), RANGE(CPSC 3651, CPSC 3659), RANGE(CPSC 3661, CPSC 4899), RANGE(CPSC 4901, CPSC 4999), PLACEMENT("EECS Elective with Approval from Both DUSs")], SELECT 1 FROM [RANGE(ECE 3000, ECE 4679), RANGE(ECE 4681, ECE 4690), RANGE(ECE 4692, ECE 4709), RANGE(ECE 4711, ECE 4720), RANGE(ECE 4722, ECE 4999), PLACEMENT("EECS Elective with Approval from Both DUSs")], SELECT 1 FROM [RANGE(ECE 3000, ECE 4679), RANGE(ECE 4681, ECE 4690), RANGE(ECE 4692, ECE 4999), PLACEMENT("EECS Elective with Approval from Both DUSs")]] : "Electives" : 3;
SELECT 1 FROM [CLASS(CPSC 4900), CLASS(ECE 4710), CLASS(ECE 4721)] : "Senior Requirement" : 2