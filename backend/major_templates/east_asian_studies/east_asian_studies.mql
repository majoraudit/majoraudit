SELECT 1 FROM [PLACEMENT("L2 East Asian Language Course"), PLACEMENT("Equivalent Qualification")] : "Prerequisites" : 1;
SELECT 6 FROM [PLACEMENT("L4 East Asian Language Course"), PLACEMENT("L5 Course with Readings in East Asian Language"), PLACEMENT("L5 Course with Readings in East Asian Language"), RANGE(CHNS 0000, CHNS 9999), RANGE(CHNS 0000, CHNS 9999), RANGE(CHNS 0000, CHNS 9999), RANGE(JAPN 0000, JAPN 9999), RANGE(JAPN 0000, JAPN 9999), RANGE(JAPN 0000, JAPN 9999), RANGE(KREN 0000, KREN 9999), RANGE(KREN 0000, KREN 9999), RANGE(KREN 0000, KREN 9999)] : "East Asian Language Courses" : 2;
SELECT 4 FROM [PLACEMENT("Course in Area of Focus"), PLACEMENT("Course in Area of Focus"), PLACEMENT("Course in Area of Focus"), SELECT 1 FROM[SELECT 3 FROM [PLACEMENT("Seminar Course in Area of Focus"), PLACEMENT("Seminar Course in Area of Focus"), PLACEMENT("Premodern Period Course in Area of Focus")], SELECT 3 FROM [PLACEMENT("Premodern Period Seminar Course in Area of Focus"), PLACEMENT("Seminar Course in Area of Focus"), PLACEMENT("Course in Area of Focus")]], PLACEMENT("Course outside Area of Focus")] : "Area of Focus Courses" : 2;
SELECT 1 FROM [PLACEMENT("Senior Seminar with Thesis"), CLASS(EAST 4900), SELECT 2 FROM [CLASS(EAST 4910), CLASS(EAST 4920)]] : "Senior Requirement" : 1;