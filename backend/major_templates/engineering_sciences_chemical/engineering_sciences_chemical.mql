SELECT 7 FROM [
  CLASS(ENAS 1940),
  SELECT 1 FROM [CLASS(CENG 1500), CLASS(CENG 2100)],
  CLASS(CENG 3000),
  CLASS(CENG 3010),
  SELECT 1 FROM [CLASS(CENG 3140), CLASS(MENG 3422), CLASS(MENG 3150), CLASS(MENG 4110)],
  SELECT 1 FROM [CLASS(CHEM 1740), CLASS(CHEM 2200)],
  CLASS(CHEM 3320)
] : "Core Courses" : 2;

SELECT 1 FROM [
  CLASS(ENAS 1300),
  CLASS(CPSC 1001),
  CLASS(CPSC 2000)
] : "Computing Course" : 3;

SELECT 1 FROM [
  DEPT("CENG"),
  DEPT("MENG"),
  DEPT("ECE"),
  DEPT("ENVE"),
  DEPT("BENG"),
  DEPT("ENAS")
] : "Engineering Elective" : 4;

SELECT 1 FROM [
  CLASS(CENG 4160),
  CLASS(CENG 4900)
] : "Senior Requirement" : 1;
