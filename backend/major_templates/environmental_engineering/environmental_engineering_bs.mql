SELECT 9 FROM [CLASS(MATH 1120), CLASS(MATH 1150), SELECT 1 FROM [CLASS(MATH 1200), CLASS(ENAS 1510)], CLASS(ENAS 1940), SELECT 1 FROM [CLASS(ENAS 1300), CLASS(S&DS 2300)], SELECT 1 FROM [SELECT 4 FROM [CLASS(CHEM 1610), CLASS(CHEM 1610L), CLASS(CHEM 1650), CLASS(CHEM 1650L)], SELECT 2 FROM [SELECT 1 FROM [SELECT 2 FROM [CLASS(CHEM 1740), CLASS(1740L)], SELECT 2 FROM [CLASS(CHEM 2200), CLASS(CHEM 2200L)]], SELECT 1 FROM [SELECT 2 FROM [CLASS(CHEM 1750), CLASS(CHEM 1750L)], SELECT 2 FROM [CLASS(CHEM 2210), CLASS(CHEM 2210L)], SELECT 2 FROM [CLASS(CHEM 2300), CLASS(CHEM 2300L)]]], SELECT 3 FROM [SELECT 1 FROM [SELECT 2 FROM [CLASS(CHEM 3320), CLASS(CHEM 3320L)], SELECT 2 FROM [CLASS(CHEM 3280), CLASS(CHEM 3280L)]], CLASS(CHEM 3330), CLASS(CHEM 3330L)]], CLASS(PHYS 1800), CLASS(PHYS 1810), SELECT 1 FROM [SELECT 2 FROM [CLASS(BIOL 1010), CLASS(BIOL 1020)], SELECT 2 FROM [CLASS(BIOL 1030), CLASS(BIOL 1040)]]] : "Prerequisites" : 1;
SELECT 8 FROM [SELECT 1 FROM [CLASS(CENG 3000), CLASS(MENG 2511)], CLASS(ENVE 1200), CLASS(ENVE 3600), CLASS(ENVE 3730), SELECT 1 FROM [CLASS(ENVE 3140), CLASS(ENVE 4480)], CLASS(ENVE 4380), CLASS(ENVE 4410), CLASS(ENVE 6420)] : "Core Courses" : 2;
SELECT 4 FROM [PLACEMENT("Elective with DUS Approval"), PLACEMENT("Technical Elective with DUS Approval"), PLACEMENT("Technical Elective with DUS Approval"), PLACEMENT("Technical Elective with DUS Approval")] : "Electives" : 3;
SELECT 1 FROM [CLASS(ENVE 4160), CLASS(ENVE 4900)] : "Senior Requirement" : 1;