SELECT 8 FROM [
  SELECT 1 FROM [CLASS(CENG 3000), CLASS(MENG 2511)],
  CLASS(ENVE 1200),
  CLASS(ENVE 3600),
  CLASS(ENVE 3730),
  SELECT 1 FROM [CLASS(ENVE 3140), CLASS(ENVE 4480)],
  CLASS(ENVE 4380),
  CLASS(ENVE 4410),
  CLASS(ENVE 6420)
] : "Core Courses" : 2;

SELECT 3 FROM [
  DEPT("ENVE"),
  DEPT("CENG"),
  DEPT("MENG"),
  DEPT("ECE"),
  DEPT("BENG")
] : "Electives" : 3;

SELECT 1 FROM [
  DEPT("ENVE"),
  DEPT("CENG"),
  DEPT("MENG"),
  DEPT("ECE"),
  DEPT("BENG"),
  DEPT("EVST"),
  DEPT("ENAS"),
  DEPT("ENRG")
] : "Additional Approved Llective" : 4;

SELECT 1 FROM [
  CLASS(ENVE 4160),
  CLASS(ENVE 4900)
] : "Senior Requirement" : 1;
