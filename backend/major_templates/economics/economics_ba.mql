SELECT 1 FROM [SELECT 2 FROM [CLASS(MATH 1100), CLASS(MATH 1110)], CLASS(MATH 1120), CLASS(MATH 1150), CLASS(MATH 1160), CLASS(ENAS 1510), CLASS(MATH 1180), CLASS(MATH 1200), RANGE(MATH 2000, MATH 9999)] : "Math Requirement" : 1;
SELECT 5 FROM [SELECT 1 FROM [CLASS(ECON 1108), CLASS(ECON 1110), CLASS(ECON 1115), RANGE(ECON 1159, ECON 9999)], SELECT 1 FROM [CLASS(ECON 1111), CLASS(ECON 1116), RANGE(ECON 1159, ECON 9999)], SELECT 1 FROM [CLASS(ECON 2121), CLASS(ECON 2125)], SELECT 1 FROM [CLASS(ECON 2122), CLASS(ECON 2126)], SELECT 1 FROM [CLASS(ECON 1117), CLASS(ECON 2123), CLASS(ECON 2136)]] : "ECON Core Courses" : 2;
SELECT 4 FROM [RANGE(ECON 1159, ECON 9999), RANGE(ECON 1159, ECON 9999), RANGE(ECON 1159, ECON 9999), SELECT 1 FROM [RANGE(ECON 1159, ECON 9999), PLACEMENT("Non-ECON Class with DUS Approval")]] : "Electives" : 3;
SELECT 2 FROM [RANGE(ECON 4400, ECON 4491), RANGE(ECON 4400, ECON 4491)] : "Senior Requirement" : 1;