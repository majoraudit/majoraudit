SELECT 4 FROM [
  CLASS(MATH 1120),
  CLASS(MATH 1150),
  SELECT 1 FROM [CLASS(PHYS 1700), CLASS(PHYS 1710), RANGE(PHYS 1700 , PHYS 1999)]
] : "Prerequisites" : 3;

SELECT 6 FROM [
  RANGE(MENG 2000 , MENG 4999),
  RANGE(ENAS 2000 , ENAS 4999),
  RANGE(ECE 2000 , ECE 4999),
  CLASS(MENG 4991),
  CLASS(MENG 4992)
] : "Core Classes" : 6;

SELECT 1 FROM [
  CLASS(MENG 4991),
  CLASS(MENG 4992),
  RANGE(MENG 4000 , MENG 4999)
] : "Senior Requirement" : 1;
