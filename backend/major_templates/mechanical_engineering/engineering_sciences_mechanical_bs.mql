SELECT 7 FROM [
  CLASS(MATH 1120),
  CLASS(MATH 1150),
  CLASS(ENAS 1510),
  SELECT 1 FROM [CLASS(PHYS 1800), CLASS(PHYS 1810), CLASS(PHYS 2000)],
  SELECT 1 FROM [CLASS(PHYS 1810), CLASS(PHYS 2010)],
  SELECT 1 FROM [CLASS(PHYS 1650L), CLASS(PHYS 2050L)],
  SELECT 1 FROM [CLASS(PHYS 1660L), CLASS(PHYS 2060L), CLASS(MENG 2616L)]
] : "Prerequisites" : 7;

SELECT 10 FROM [
  RANGE(MENG 2000 , MENG 4999),
  RANGE(ENAS 2000 , ENAS 4999),
  RANGE(ECE 2000 , ECE 4999),
  CLASS(MENG 4991),
  CLASS(MENG 4992)
] : "Core Classes" : 10;

SELECT 1 FROM [
  CLASS(MENG 4154),
  CLASS(MENG 4991),
  CLASS(MENG 4992),
  RANGE(MENG 4000 , MENG 4999)
] : "Senior Requirement" : 1;
