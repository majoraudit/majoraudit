SELECT 8 FROM [
  CLASS(MATH 1120),
  CLASS(MATH 1150),
  CLASS(ENAS 1510),
  SELECT 1 FROM [CLASS(PHYS 1800), CLASS(PHYS 1810), CLASS(PHYS 2000)],
  SELECT 1 FROM [CLASS(PHYS 1810), CLASS(PHYS 2010)],
  SELECT 1 FROM [CLASS(PHYS 1650L), CLASS(PHYS 2050L)],
  SELECT 1 FROM [CLASS(PHYS 1660L), CLASS(PHYS 2060L)],
  SELECT 1 FROM [CLASS(CHEM 1610), TAG("Equivalent Placement or Credit (AP 4/5 or IB 6/7)")]
] : "Prerequisites" : 8;

SELECT 14 FROM [
  CLASS(ENAS 1300),
  CLASS(ENAS 1940),
  SELECT 1 FROM [CLASS(MATH 2220), CLASS(MATH 2250)],
  CLASS(ECE 2000),
  CLASS(MENG 1105),
  CLASS(MENG 2311),
  CLASS(MENG 2511),
  CLASS(MENG 2615),
  CLASS(MENG 2616L),
  CLASS(MENG 3125),
  CLASS(MENG 3323),
  CLASS(MENG 3422),
  CLASS(MENG 3423L),
  CLASS(MENG 3424),
  CLASS(MENG 3020L)
] : "Core Classes" : 14;

SELECT 3 FROM [
  RANGE(MENG 3000 , MENG 4999),
  RANGE(ENAS 2000 , ENAS 4999),
  CLASS(MENG 4991),
  CLASS(MENG 4992)
] : "Electives" : 3;

SELECT 2 FROM [
  CLASS(MENG 4137L),
  CLASS(MENG 4138L)
] : "Senior Requirement" : 2;
