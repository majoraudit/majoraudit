SELECT 5 FROM [CLASS(CPSC 2010), SELECT 1 FROM [CLASS(CPSC 2020), CLASS(MATH 2440)], CLASS(CPSC 2230), CLASS(CPSC 3230), CLASS(CPSC 3650)] : "Core Classes" : 2;

SELECT 4 FROM [RANGE(CPSC 2000 , CPSC 9999), RANGE(CPSC 2000 , CPSC 9999), RANGE(CPSC 2000 , CPSC 9999), RANGE(CPSC 2000 , CPSC 9999)] : "Electives" : 3;

SELECT 1 FROM [CLASS(CPSC 4900)] : "Senior Requirement" : 1;