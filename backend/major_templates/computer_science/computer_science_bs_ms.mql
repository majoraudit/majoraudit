SELECT 5 FROM [
    CLASS(CPSC 2010),
    SELECT 1 FROM [CLASS(CPSC 2020), CLASS(MATH 2440)],
    CLASS(CPSC 2230),
    CLASS(CPSC 3230),
    SELECT 1 FROM [CLASS(CPSC 3650), CLASS(CPSC 3660)]
] : "Core Classes" : 1

SELECT 6 FROM [
    RANGE(CPSC 2000 , CPSC 9999),
    RANGE(CPSC 2000 , CPSC 9999),
    RANGE(CPSC 2000 , CPSC 9999),
    RANGE(CPSC 2000 , CPSC 9999),
    RANGE(CPSC 2000 , CPSC 9999),
    RANGE(CPSC 2000 , CPSC 9999)
] : "CS Electives (Intermediate/Advanced)" : 2

SELECT 1 FROM [
    CLASS(CPSC 4900)
] : "Senior Project" : 3

SELECT 8 FROM [
    RANGE(CPSC 6000 , CPSC 6999),
    RANGE(CPSC 6000 , CPSC 6999),
    RANGE(CPSC 6000 , CPSC 6999),
    RANGE(CPSC 6000 , CPSC 6999),
    RANGE(CPSC 6000 , CPSC 6999),
    RANGE(CPSC 6000 , CPSC 6999),
    RANGE(CPSC 6000 , CPSC 6999),
    RANGE(CPSC 6000 , CPSC 6999)
] : "Graduate Courses (Total 8)" : 4
