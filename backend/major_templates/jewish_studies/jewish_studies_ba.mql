SELECT 3 FROM [
  CLASS(JDST 1000),
  CLASS(JDST 3035),
  CLASS(JDST 2000),
  CLASS(JDST 2001),
  CLASS(JDST 3681),
  CLASS(JDST 3693),
  PLACEMENT("Survey in Hebrew and Jewish Literature")
] : "Core Classes" : 3;

SELECT 8 FROM [
  SELECT 2 FROM [CLASS(HEBR 1100), CLASS(HEBR 1200), PLACEMENT("Hebrew Literature")],
  PLACEMENT("Ancient Israel and Hebrew Bible"),
  PLACEMENT("Second Temple and Talmudic Judaism"),
  PLACEMENT("Medieval and Renaissance Jewish Civilization"),
  PLACEMENT("Modern Jewish History and Civilization"),
  PLACEMENT("Jewish and Hebrew Literature"),
  PLACEMENT("Jewish Thought")
] : "Electives" : 8;

SELECT 2 FROM [CLASS(JDST 4491), CLASS(JDST 4492)] : "Senior Requirement" : 1;
