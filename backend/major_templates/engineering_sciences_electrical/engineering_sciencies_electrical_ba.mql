SELECT 4 FROM [
  SELECT 1 FROM [CLASS(ENAS 1940), CLASS(MATH 2220), CLASS(MATH 2250), CLASS(MATH 2260)],
  CLASS(ECE 2000),
  CLASS(ECE 2011),
  CLASS(ECE 2020)
] : "Core Courses" : 2;

SELECT 2-3 FROM [
  RANGE(ECE 3000, ECE 4999)
] : "ECE Electives" : 3;

SELECT 1-2 FROM [
  CLASS(ECE 4710),
  CLASS(ECE 4721)
] : "Senior Requirement" : 1;
