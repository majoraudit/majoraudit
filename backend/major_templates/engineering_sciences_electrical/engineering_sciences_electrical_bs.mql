SELECT 6 FROM [
  CLASS(ENAS 1940),
  SELECT 1 FROM [CLASS(MATH 2220), CLASS(MATH 2250), CLASS(MATH 2260)],
  CLASS(ECE 2000),
  CLASS(ECE 2011),
  CLASS(ECE 2020),
  CLASS(ECE 2031)
] : "Core Courses" : 2;

SELECT 3 FROM [
  RANGE(ECE 4000, ECE 4999)
] : "ECE Electives" : 3;

SELECT 2-3 FROM [
  RANGE(ECE 3000, ECE 4999)
] : "Additional ECE Electives" : 4;

SELECT 1-2 FROM [
  CLASS(ECE 4710),
  CLASS(ECE 4721),
  CLASS(ECE 4811)
] : "Senior Requirement" : 1;
