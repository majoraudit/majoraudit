SELECT 1 FROM [
  CLASS(ITAL 1300),
  TAG("Equivalent Placement or Credit")
] : "Prerequisites" : 1;

SELECT 8 FROM [
  CLASS(ITAL 1400),
  SELECT 1 FROM [CLASS(ITAL 1500), CLASS(ITAL 1510)],
  SELECT 1 FROM [CLASS(ITAL 4162), CLASS(ITAL 4172)],
  SELECT 1 FROM [CLASS(ITAL 1310), TAG("Equivalent Dante Course")],
  RANGE(ITAL 1400 , ITAL 9999),
  RANGE(ITAL 1400 , ITAL 9999),
  RANGE(ITAL 1400 , ITAL 9999),
  RANGE(ITAL 1400 , ITAL 9999)
] : "Core Classes" : 5;

SELECT 2 FROM [
  RANGE(LITR 1000 , LITR 9999),
  RANGE(HIST 1000 , HIST 9999),
  RANGE(HSAR 1000 , HSAR 9999),
  RANGE(LING 1000 , LING 9999),
  RANGE(PHIL 1000 , PHIL 9999),
  RANGE(FILM 1000 , FILM 9999)
] : "Electives" : 2;

SELECT 1 FROM [CLASS(ITAL 4491)] : "Senior Requirement" : 1;