SELECT 4 FROM [
    SELECT 1 FROM [CLASS(ENAS 1940), CLASS(MATH 2460)],
    SELECT 1 FROM [CLASS(S&DS 2410), CLASS(S&DS 2380)],
    SELECT 1 FROM [CLASS(S&DS 3610), CLASS(S&DS 2300)],
    SELECT 1 FROM [CLASS(AMTH 2440), CLASS(CPSC 2020)]
] : "Core Requirements (ODEs, Probability, Data Analysis, Discrete Math)" : 3;

SELECT 6 FROM [
    RANGE(AMTH 2000, AMTH 9999),
    RANGE(MATH 2000, MATH 9999),
    RANGE(S&DS 2000, S&DS 9999),
    RANGE(CPSC 2000, CPSC 9999),
    RANGE(ECON 2000, ECON 9999),
    RANGE(ASTR 2000, ASTR 9999),
    RANGE(CHEM 2000, CHEM 9999),
    RANGE(EPS 2000, EPS 9999),
    RANGE(PHYS 2000, PHYS 9999),
    RANGE(BENG 2000, BENG 9999),
    RANGE(MENG 2000, MENG 9999),
    RANGE(CENG 2000, CENG 9999),
    RANGE(ECE 2000, ECE 9999),
    RANGE(LING 2000, LING 9999),
    RANGE(PHIL 2000, PHIL 9999),
    RANGE(PSYC 2000, PSYC 9999),
    RANGE(ENAS 2000, ENAS 9999),
    RANGE(APHY 2000, APHY 9999)
] : "Breadth and Concentration Courses (Areas a–m; includes ≥3-course concentration)" : 4;

SELECT 1 FROM [
    CLASS(MATH 3020),
    CLASS(MATH 3050),
    CLASS(MATH 3100),
    CLASS(MATH 3200),
    CLASS(MATH 3250),
    CLASS(MATH 4470)
] : "Vector Analysis / Advanced Analysis (BS-only)" : 5;

