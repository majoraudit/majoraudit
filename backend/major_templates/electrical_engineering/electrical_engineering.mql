SELECT 12 FROM [
  CLASS(ENAS 1940),
  SELECT 1 FROM [CLASS(MATH 2220), CLASS(MATH 2250), CLASS(MATH 2260)],
  CLASS(APHY 3220),
  SELECT 1 FROM [CLASS(S&DS 2380), CLASS(S&DS 2410)],
  CLASS(ECE 2000),
  CLASS(ECE 2011),
  CLASS(ECE 2020),
  CLASS(ECE 2031),
  CLASS(ECE 3101),
  CLASS(ECE 3200),
  CLASS(ECE 3250),
  CLASS(ECE 3481)
] : "EENG Core Courses" : 2;

SELECT 3 FROM [
  RANGE(ECE 4000, ECE 4999),
  RANGE(CENG 4000, CENG 4999),
  RANGE(MENG 4000, MENG 4999),
  RANGE(ENVE 4000, ENVE 4999),
  RANGE(BENG 4000, BENG 4999),
  RANGE(ENAS 4000, ENAS 4999)
] : "Engineering Electives" : 3;

SELECT 1 FROM [
  DEPT("ECE"),
  DEPT("CENG"),
  DEPT("MENG"),
  DEPT("ENVE"),
  DEPT("BENG"),
  DEPT("ENAS")
] : "Additional Engineering Elective" : 4;

SELECT 1 FROM [
  CLASS(ECE 4811)
] : "Senior Requirement" : 1;
