SELECT 6 FROM [SELECT 2 FROM [CLASS(MATH 1120), PLACEMENT("Equivalent Qualification")], SELECT 2 FROM [CLASS(MATH 1150), PLACEMENT("Equivalent Qualification")], SELECT 2 FROM [CLASS(ENAS 1510), RANGE(MATH 1200, MATH 9999)], SELECT 1 FROM [RANGE(ENAS 1300, ENAS 9999), PLACEMENT("Programming Course with DUS Approval")], SELECT 1 FROM [CLASS(PHYS 1800), RANGE(PHYS 1810, PHYS 9999)], RANGE(PHYS 1810, PHYS 9999)] : "Prerequisites" : 1;
SELECT 1 FROM [CLASS(ENAS 1940), CLASS(MATH 2220), CLASS(MATH 2250), CLASS(MATH 2260​)] : "Mathematics and Basic Sciences Core Course", 2;
SELECT 4 FROM [CLASS(ECE 2000), CLASS(ECE 2011), CLASS(ECE 2020)] : "Electrical Engineering Core Classes : 2;
SELECT 3 FROM [SELECT 1 FROM [CLASS(CPSC 3650), CLASS(CPSC 3660), CLASS(MENG 3020L), CLASS(MENG 2050), CLASS(MENG 4673), CLASS(BENG 4611), CLASS(PHYS 4300), CLASS(APHY 4580), RANGE(CPSC 4000, CPSC 4999)], SELECT 1 FROM [CLASS(CPSC 3650), CLASS(CPSC 3660), CLASS(MENG 3020L), CLASS(MENG 2050), CLASS(MENG 4673), CLASS(BENG 4611), CLASS(PHYS 4300), CLASS(APHY 4580), CLASS(ECE 4680), CLASS(ECE 4691), RANGE(CPSC 4000, CPSC 4999)], SELECT 1 FROM [CLASS(CPSC 3650), CLASS(CPSC 3660), CLASS(MENG 3020L), CLASS(MENG 2050), CLASS(MENG 4673), CLASS(BENG 4611), CLASS(PHYS 4300), CLASS(APHY 4580), CLASS(ECE 4710), CLASS(ECE 4721), RANGE(CPSC 4000, CPSC 4999)]] : "Electives" : 3;
SELECT 1 FROM [CLASS(ECE 4710), CLASS(ECE 4721)] : "Senior Requirement" : 1;