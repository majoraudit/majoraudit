        ],
        SELECT 1 FROM [CLASS(FREN 4910)]
    ],
    SELECT 12 FROM [
        SELECT 1 FROM [CLASS(FREN 1700), PLACEMENT("Equivalent to FREN 1700 approved by DUS")],
        SELECT 5 FROM [
            TAG("YC FREN Group B 2000 Plus"),
            TAG("YC FREN Group B 2000 Plus"),
