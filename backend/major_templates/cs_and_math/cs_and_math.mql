SELECT 4 FROM [CLASS(CPSC 2010), CLASS(CPSC 2230), CLASS(CPSC 3230), SELECT 1 FROM [CLASS(CPSC 3650), CLASS(CPSC 3660)]] : "Core CS Classes" : 2;
SELECT 1 FROM [CLASS(CPSC 4300), CLASS(CPSC 4400), CLASS(CPSC 4520), CLASS(CPSC 4550), CLASS(CPSC 4600), CLASS(CPSC 4630), CLASS(CPSC 4650), CLASS(CPSC 4680), CLASS(CPSC 4690), CLASS(CPSC 4860)] : "Advanced CPSC Course with Significant Mathematical Content" : 3;
SELECT 1 FROM [TAG("YC CPSC&MATH Adv CS Elective")] : "CPSC Electives" : 4;
SELECT 3 FROM [SELECT 1 FROM [CLASS(MATH 1200), RANGE(MATH 2250, MATH 4690), RANGE(MATH 5000, MATH 5999)], SELECT 1 FROM [CLASS(MATH 2250), CLASS(MATH 2260)], CLASS(MATH 2440)] : "Core Math Classes" : 2;
SELECT 5 FROM [
    SELECT 0-5 FROM [
        RANGE(MATH 2250, MATH 4690)
    ],
    SELECT 0-5 FROM [
        RANGE(MATH 5000, MATH 5999)
    ]
] : "Math Electives" : 4;
SELECT 1 FROM [CLASS(CPSC 4900), CLASS(MATH 4750)] : "Senior Requirement" : 1;