SELECT 10 FROM [
  CLASS(CPSC 2010),
  SELECT 1 FROM [CLASS(CPSC 2020), CLASS(MATH 2440)],
  CLASS(CPSC 2230),
  CLASS(CPSC 3230),
  SELECT 1 FROM [CLASS(CPSC 3650), CLASS(CPSC 3660)],
  CLASS(ECE 2000),
  CLASS(ECE 2011),
  CLASS(ECE 2020),
  CLASS(ECE 2031),
  SELECT 1 FROM [CLASS(MATH 2220), CLASS(MATH 2250), CLASS(MATH 2260), CLASS(S&DS 2380), CLASS(S&DS 2410)]
] : "Core Courses" : 2;

SELECT 2 FROM [
  RANGE(CPSC 3000, CPSC 4999)
] : "CPSC Electives" : 3;

SELECT 2 FROM [
  RANGE(ECE 3000, ECE 4999)
] : "ECE Electives" : 4;

SELECT 1 FROM [
  CLASS(CPSC 4900),
  CLASS(ECE 4710),
  CLASS(ECE 4721)
] : "Senior Requirement" : 1;
