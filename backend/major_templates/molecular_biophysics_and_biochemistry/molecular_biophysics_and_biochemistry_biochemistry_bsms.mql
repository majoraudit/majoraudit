SELECT 4 FROM [
  CLASS(BIOL 1010),
  CLASS(BIOL 1020),
  CLASS(BIOL 1030),
  CLASS(BIOL 1040)
] : "Biology Prerequisites" : 10;

SELECT 4 FROM [
  SELECT 1 FROM [
    CLASS(CHEM 1610),
    CLASS(CHEM 1630)
  ],
  SELECT 1 FROM [
    CLASS(CHEM 1650),
    CLASS(CHEM 1670)
  ],
  CLASS(CHEM 1340L),
  CLASS(CHEM 1360L)
] : "General Chemistry Prerequisites" : 9;  

SELECT 2 FROM [
  SELECT 1 FROM [
    CLASS(CHEM 1740),
    CLASS(CHEM 2200)
  ],
  CLASS(CHEM 2220L)
] : "Organic Chemistry Prerequisites" : 8;

SELECT 2 FROM [
  CLASS(MATH 1120),
  SELECT 1 FROM [
    CLASS(MATH 1150),
    CLASS(MATH 1160)
  ]
] : "Calculus Prerequisites" : 7;

SELECT 4 FROM [
  CLASS(CHEM 3320),
  SELECT 1 FROM [
    CLASS(PHYS 1800),
    CLASS(PHYS 2000),
    CLASS(PHYS 2600)
  ],
  SELECT 1 FROM [
    CLASS(PHYS 1810),
    CLASS(PHYS 2010),
    CLASS(PHYS 2610)
  ],
  SELECT 1 FROM [
    CLASS(CENG 3000),
    CLASS(APHY 4200),
    CLASS(MENG 2110),
    PLACEMENT("Alternative elective based on petition")
  ]
] : "Biophysics Requirements" : 6;

SELECT 3 FROM [
  CLASS(MB&B 3000),
  CLASS(MB&B 3010),
  SELECT 1 FROM [
    CLASS(CHEM 1750),
    RANGE(CHEM 2000 , CHEM 9999)
  ]
] : "Biochemistry Requirements" : 5;

SELECT 1 FROM [
  CLASS(MCDB 2050),
  CLASS(MCDB 2020),
  PLACEMENT("Other based on petiton")
] : "Mollecular, Cellular, or Organismal Biology Requirement" : 5;

SELECT 1 FROM [
  CLASS(MB&B 2680),
  PLACEMENT("Other Science and Society courses based on petiton")
] : "Science and Society Core Requirement" : 4;

SELECT 1 FROM [
  CLASS(MB&B 4700),
  TAG("Course-based undergraduate research")
] : "Research in Biochemistry Requirement" : 3;

SELECT 2 FROM [
  CLASS(MB&B 3650),
  CLASS(MB&B 3310),
  CLASS(MB&B 4450),
  CLASS(MB&B 4490),
  CLASS(MB&B 4430),
  PLACEMENT("Other 3000+ course based on petition")
] : "Advanced Chemical Biology Requirement" : 3;

SELECT 6 FROM [ 
  RANGE(MB&B 5000 , MB&B 9999),
  RANGE(MB&B 5000 , MB&B 9999),
  TAG("5000+ STEM elective"),
  TAG("5000+ STEM elective"),
  TAG("5000+ STEM elective"),
  TAG("5000+ STEM elective")
] : "Elective Courses" : 2;

SELECT 5 FROM [
  CLASS(MB&B 4900),
  CLASS(MB&B 4700),
  CLASS(MB&B 4710),
  CLASS(MB&B 5700),
  CLASS(MB&B 5701)
] : "Senior Requirement" : 1;
