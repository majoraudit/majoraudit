SELECT 4 FROM [
  CLASS(BIOL 1010),
  CLASS(BIOL 1020),
  CLASS(BIOL 1030),
  CLASS(BIOL 1040)
] : "Biology Prerequisites" : 15;

SELECT 4 FROM [
  SELECT 1 FROM [
    CLASS(CHEM 1610),
    CLASS(CHEM 1630)
  ],
  SELECT 1 FROM [
    CLASS(CHEM 1650),
    CLASS(CHEM 1670)
  ],
  CLASS(CHEM 1340L),
  CLASS(CHEM 1360L)
] : "General Chemistry Prerequisites" : 14;  

SELECT 3 FROM [
  SELECT 1 FROM [
    CLASS(CHEM 1740),
    CLASS(CHEM 2200)
  ],
  SELECT 1 FROM [
    CLASS(CHEM 1750),
    CLASS(CHEM 2210)
  ],
  CLASS(CHEM 2220L)
] : "Organic Chemistry Prerequisites" : 13;

SELECT 2 FROM [
  CLASS(MATH 1120),
  SELECT 1 FROM [
    CLASS(MATH 1150),
    CLASS(MATH 1160)
  ]
] : "Calculus Prerequisites" : 12;

SELECT 3 FROM [
  SELECT 1 FROM [
    CLASS(MB&B 2750),
    CLASS(CHEM 3320)
  ],
  SELECT 1 FROM [
    CLASS(PHYS 1700),
    CLASS(PHYS 1800),
    CLASS(PHYS 2000),
    CLASS(PHYS 2600)
  ],
  SELECT 1 FROM [
    CLASS(PHYS 1710),
    CLASS(PHYS 1810),
    CLASS(PHYS 2010),
    CLASS(PHYS 2610)
  ]
] : "Biophysics Requirements" : 11;

SELECT 3 FROM [
  CLASS(MB&B 3000),
  CLASS(MB&B 3010),
  SELECT 1 FROM [
    CLASS(CHEM 1750),
    RANGE(CHEM 2000 , CHEM 9999)
  ]
] : "Biochemistry Requirements" : 10;

SELECT 1 FROM [
  CLASS(MB&B 2680),
  PLACEMENT("Other Science and Society courses based on petiton")
] : "Science and Society Core Requirement" : 9;

SELECT 1 FROM [
  PLACEMENT("Physics/Biochemistry Lab or Critical Tools with DUS approval")
] : "Practical Skills Requirement" : 8;

SELECT 2 FROM [
  SELECT 1 FROM [
    RANGE(S&DS 1000 , S&DS 9999),
    RANGE_TAG(MATH 2000 , MATH 9999 , "In linear algebra, probability, statistics, or stochastic processes")
  ],
  SELECT 1 FROM [
    RANGE(PSYC 1100 , PSYC 9999)
  ]
] : "Staistics and Psychology Requirement" : 7;

SELECT 2 FROM [ 
  CLASS(MB&B 1010L),
  CLASS(PHYS 1650L),
  CLASS(PHYS 1660L),
  CLASS(MB&B 3640),
  TAG("Others with DUS approval")
] : "Physics Lab Requirement" : 5;

SELECT 1 FROM [
  CLASS(MB&B 4700),
  TAG("Others with DUS approval")
] : "Research Requirement" : 4;

SELECT 1 FROM [
  CLASS(MB&B 4490),
  CLASS(MB&B 4450),
  CLASS(MB&B 4520),
  CLASS(BENG 3500),
  CLASS(MCDB 3150),
  CLASS(MCDB 4500),
  TAG("Others with DUS approval")
] : "Advanced Biomedical Lecture or Seminar Requirement" : 3;

SELECT 1 FROM [ 
  RANGE_TAG(MB&B 2000 , MB&B 9999 , "Seminar or Lecture")
] : "Elective Course" : 2;

SELECT 1 FROM [
  CLASS(MB&B 4900),
  CLASS(MB&B 4910)
] : "Senior Requirement" : 1;

