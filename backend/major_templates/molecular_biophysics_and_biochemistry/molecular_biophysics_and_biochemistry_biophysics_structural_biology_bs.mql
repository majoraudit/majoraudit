SELECT 2 FROM [
  CLASS(BIOL 1010),
  CLASS(BIOL 1020)
] : "Biology Prerequisites" : 10;

SELECT 4 FROM [
  SELECT 1 FROM [
    CLASS(CHEM 1610),
    CLASS(CHEM 1630)
  ],
  SELECT 1 FROM [
    CLASS(CHEM 1650),
    CLASS(CHEM 1670)
  ],
  CLASS(CHEM 1340L),
  CLASS(CHEM 1360L)
] : "General Chemistry Prerequisites" : 9;  

SELECT 2 FROM [
  SELECT 1 FROM [
    CLASS(CHEM 1740),
    CLASS(CHEM 2200)
  ],
  CLASS(CHEM 2220L)
] : "Organic Chemistry Prerequisites" : 8;

SELECT 2 FROM [
  CLASS(MATH 1120),
  SELECT 1 FROM [
    CLASS(MATH 1150),
    CLASS(MATH 1160)
  ]
] : "Calculus Prerequisites" : 7;

SELECT 4 FROM [
  SELECT 1 FROM [
    CLASS(MB&B 2750),
    CLASS(CHEM 3320)
  ],
  SELECT 1 FROM [
    CLASS(PHYS 1700),
    CLASS(PHYS 1800),
    CLASS(PHYS 2000),
    CLASS(PHYS 2600)
  ],
  SELECT 1 FROM [
    CLASS(PHYS 1710),
    CLASS(PHYS 1810),
    CLASS(PHYS 2010),
    CLASS(PHYS 2610)
  ],
  TAG("3000+ course in physical sciences, mathematics, statistics or computer science")
] : "Biophysics Requirements" : 6;

SELECT 3 FROM [
  CLASS(MB&B 3000),
  CLASS(MB&B 3010),
  SELECT 1 FROM [
    CLASS(CHEM 1750),
    RANGE(CHEM 2000 , CHEM 9999)
  ]
] : "Biochemistry Requirements" : 5;

SELECT 1 FROM [
  CLASS(MB&B 2680),
  PLACEMENT("Other Science and Society courses based on petiton")
] : "Science and Society Core Requirement" : 4;

SELECT 2 FROM [
  PLACEMENT("Physics/Biochemistry Lab or Critical Tools with DUS approval"),
  PLACEMENT("Physics/Biochemistry Lab or Critical Tools with DUS approval")
] : "Practical Skills Requirement" : 3;

SELECT 1 FROM [
  CLASS(MATH 1200),
  CLASS(MATH 2250),
  CLASS(CPSC 1001),
  CLASS(S&DS 2380)
] : "Computer Science, Math, and Statistics Requirement" : 3;

SELECT 1 FROM [
  CLASS(CHEM 3320),
  TAG("3000+ elective in thermodynamics, statistical mech, quantum mechanics, or spectroscopy")
] : "Biophysical Chemistry Requirement" : 3;

SELECT 1 FROM [
  CLASS(MB&B 3300),
  CLASS(MB&B 4200),
  CLASS(MB&B 4350),
  CLASS(CHEM 3330),
  CLASS(CHEM 4060),
  CLASS(CHEM 4290),
  PLACEMENT("Other 2000+ course with emphasis on measurement and/or modeling of energy, kinetics, or structure based on petition")
] : "Tools and Quantitative Analysis Requirement" : 3;

SELECT 1 FROM [
  CLASS(MB&B 4700),
  CLASS(CHEM 3550L),
  TAG("Course-based undergraduate research based on petition")
] : "Research in Biophysics and Structural Biology Requirement" : 3;

SELECT 1 FROM [
  CLASS(MB&B 4200),
  CLASS(MB&B 5200),
  PLACEMENT("Other based on petition")
] : "Advanced Biophysics and Structural Biology Lecture or Seminar Requirement" : 3;

SELECT 2 FROM [ 
  RANGE_TAG(MB&B 2000 , MB&B 9999, "Seminar or Lecture"),
  SELECT 1 FROM [
    RANGE_TAG(MB&B 2000 , MB&B 9999, "Seminar or Lecture"),
    TAG("Lecture course in STEM")
  ]
] : "Elective Courses" : 2;

SELECT 1 FROM [
  CLASS(MB&B 4900),
  CLASS(MB&B 4910)
] : "Senior Requirement" : 1;
